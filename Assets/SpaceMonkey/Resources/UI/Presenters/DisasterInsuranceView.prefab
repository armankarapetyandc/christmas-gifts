      m_Calls: []
  m_text: "Commercial property insurance is a contract between your business and
    a small business insurance company that specifies how you\u2019re compensated
    if your business\u2019s physical assets are stolen, destroyed or damaged due
    to a problem covered by your policy. This coverage is also called business property
    insurance.\n\nThe policy\_<B>Aegis Mutual</B>\_is offering has an occurrence\_limit
    of <B>$20,000 per incident.</B> The limit dictates the most you\u2019ll get paid
    by the insurance company for a single claim.\n\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6e6891c03f13f1e44a213bc615ab5855, type: 2}
