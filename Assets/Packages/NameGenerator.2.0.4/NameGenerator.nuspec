<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>NameGenerator</id>
    <version>2.0.4</version>
    <authors>0xB01b</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>Rock_With_Hat_Big.png</icon>
    <description>A small library for generating random names and gamertags.</description>
    <repository url="https://github.com/tatapuchi/Name-Generator" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="System.Text.Json" version="5.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>